{
  "hosting": {
    "public": "site",
    "ignore": ["firebase.template.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|gif)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
      {"source": "/services/**", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
    ],
    "rewrites": [
      {"source": "/services/**", "run": {"serviceId": "replace-with-service-name", "region": "us-central1"}}
    ]
  }
}
